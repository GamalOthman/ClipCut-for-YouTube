{
  "manifest_version": 3,
  "name": "ClipCut for YouTube",
  "short_name": "ClipCut",
  "version": "2.1.0",
  "description": "Mark start and end while you watch YouTube, then download the clip. Needs the helper installed by Setup.bat.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "cookies",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ClipCut",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "111",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}